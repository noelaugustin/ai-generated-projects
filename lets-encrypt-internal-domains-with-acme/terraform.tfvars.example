cloudflare_api_token   = "your-api-token"
cloudflare_account_id  = "your-account-id"
cloudflare_zone_id     = "your-zone-id"

domain     = "example.com"
subdomain  = "ops.example.com"

acme_email  = "admin@example.com"
acme_issuer = "letsencrypt-staging" # or letsencrypt-prod

# Managed Docker Network configuration
docker_network_subnet  = "172.21.0.0/16"
shared_network_name    = "kind-shared"
shared_network_gateway = "172.21.0.1"
metallb_ip_range       = "172.21.255.200-172.21.255.250"
